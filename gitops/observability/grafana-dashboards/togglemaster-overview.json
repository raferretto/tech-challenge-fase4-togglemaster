      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(togglemaster_http_server_requests_total{service_name=\"evaluation-service\",http_response_status_code=~\"5..\"}[5m])) / sum(rate(togglemaster_http_server_requests_total{service_name=\"evaluation-service\"}[5m]))",
